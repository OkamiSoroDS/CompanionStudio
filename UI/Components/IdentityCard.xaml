<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CompanionStudio.App.UI.Components.IdentityCard">


    <Border
        Padding="20"
        StrokeShape="RoundRectangle 15">


        <VerticalStackLayout
            Spacing="8">


            <Label
                x:Name="TitleLabel"
                Text="Identidad del compañero"
                FontSize="22"
                FontAttributes="Bold"/>


            <Label
                x:Name="NameLabel"
                Text="Nombre:"/>


            <Label
                x:Name="VersionLabel"
                Text="Versión:"/>


            <Label
                x:Name="IdLabel"
                Text="ID:"/>


            <Label
                x:Name="StatusLabel"
                Text="Estado:"/>


            <Label
                x:Name="IntegrityLabel"
                Text="Integridad:"/>


            <Label
                x:Name="LockLabel"
                Text="Bloqueo del núcleo:"/>


            <Label
                x:Name="FingerprintLabel"
                Text="Huella digital:"/>


            <Button
                x:Name="ActiveButton"
                Text="Seleccionar identidad activa"
                Clicked="SetActive_Clicked"/>


            <Button
                x:Name="EditButton"
                Text="Editar identidad"
                Clicked="Edit_Clicked"/>


            <Button
                x:Name="DeleteButton"
                Text="Borrar identidad"
                BackgroundColor="#B3261E"
                TextColor="White"
                Clicked="Delete_Clicked"/>


        </VerticalStackLayout>


    </Border>


</ContentView>