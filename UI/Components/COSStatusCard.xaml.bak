<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CompanionStudio.App.UI.Components.COSStatusCard">


    <Border
        Padding="15"
        StrokeShape="RoundRectangle 15">


        <VerticalStackLayout Spacing="8">


            <Label
    x:Name="TitleLabel"
    FontSize="18"
    FontAttributes="Bold"/>


            <Label
                x:Name="StatusLabel"
                Text="Estado: verificando..."
                FontSize="16"/>


            <Label
                x:Name="VersionLabel"
                Text="Versión:"
                FontSize="14"/>


            <Label
                x:Name="StartLabel"
                Text="Inicio:"
                FontSize="14"/>


        </VerticalStackLayout>


    </Border>


</ContentView>