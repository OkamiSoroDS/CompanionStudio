<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CompanionStudio.App.UI.Components.RuntimeStatusCard">

    <Border
        Padding="20"
        StrokeShape="RoundRectangle 15">

        <VerticalStackLayout Spacing="8">

            <Label
                Text="Runtime Status"
                FontSize="22"
                FontAttributes="Bold"/>

            <Label
                x:Name="StatusLabel"
                Text="Status: Offline"/>

            <Label
                x:Name="ModelLabel"
                Text="Model: None"/>

        </VerticalStackLayout>

    </Border>

</ContentView>