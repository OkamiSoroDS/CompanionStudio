<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CompanionStudio.App.UI.Components.IdentityCard">

    <Border
        StrokeShape="RoundRectangle 20"
        Padding="20"
        Margin="10">

        <VerticalStackLayout Spacing="10">

            <Label
                Text="Companion Identity"
                FontSize="22"
                FontAttributes="Bold"/>

            <Label
                Text="Name: Lilith"
                FontSize="18"/>

            <Label
                Text="Status: Active"/>

            <Label
                Text="Identity Hash: Pending"/>

        </VerticalStackLayout>

    </Border>

</ContentView>