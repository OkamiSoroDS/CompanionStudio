<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CompanionStudio.App.UI.Components.IdentityCard">


    <Border
        Padding="20"
        StrokeShape="RoundRectangle 15">


        <VerticalStackLayout
            Spacing="8">


            <Label
                Text="Companion Identity"
                FontSize="22"
                FontAttributes="Bold"/>



            <Label
                x:Name="NameLabel"
                Text="Name: --"/>



            <Label
                x:Name="VersionLabel"
                Text="Version: --"/>



            <Label
                x:Name="IdLabel"
                Text="ID: --"/>



            <Label
                x:Name="StatusLabel"
                Text="Status: Offline"/>



            <Label
                x:Name="IntegrityLabel"
                Text="Integrity: --"/>



            <Label
                x:Name="LockLabel"
                Text="Core Lock: --"/>



            <Label
                x:Name="FingerprintLabel"
                Text="Fingerprint: --"/>



            <Button
                Text="Set Active Identity"
                Clicked="SetActive_Clicked"/>


        </VerticalStackLayout>


    </Border>


</ContentView>