<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:CompanionStudio.App.UI.Components"
    x:Class="CompanionStudio.App.UI.Views.DashboardPage"
    Title="Dashboard">


    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="20">


            <Label
                Text="Companion Studio"
                FontSize="32"
                FontAttributes="Bold"
                HorizontalOptions="Center"/>


            <Label
                Text="Identity Management Dashboard"
                FontSize="16"
                HorizontalOptions="Center"/>


            <components:IdentityCard />


        </VerticalStackLayout>

    </ScrollView>


</ContentPage>